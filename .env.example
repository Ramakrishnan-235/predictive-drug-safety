# ==============================================================================
# GeriSafe CDSS - Environment Variables Configuration Template
# ==============================================================================

# --- API & Server Settings ---
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- HuggingFace / Model Authentication ---
# Required if downloading / loading gated MedGemma weights directly from HuggingFace
HF_TOKEN=your_huggingface_token_here
HUGGINGFACE_HUB_TOKEN=your_huggingface_token_here

# --- LLM Provider Settings ---
# Options: "auto", "medgemma", "ollama", "openai", "gemini"
LLM_PROVIDER=auto

# Optional API Keys for Cloud Fallbacks
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# --- Local Ollama / Docker Endpoint ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=medgemma:1.5

# --- Frontend Settings ---
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
