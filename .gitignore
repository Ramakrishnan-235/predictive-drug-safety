# ==============================================================================
# Byte-compiled / optimized / DLL files & Python caches
# ==============================================================================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
dist/
build/
pip-wheel-metadata/
__pypackages__/
*.whl

# ==============================================================================
# Caches, testing, and linting
# ==============================================================================
.pytest_cache/
.coverage
coverage.xml
*.cover
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.ipynb_checkpoints/
.cache/

# ==============================================================================
# Virtual environments
# ==============================================================================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ==============================================================================
# Environment variables & secrets
# ==============================================================================
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key

# ==============================================================================
# IDEs and editors
# ==============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ==============================================================================
# Datasets and large data files (PhysioNet / DrugBank / DDI — do not commit)
# ==============================================================================
# Keep directory layout via .gitkeep; ignore everything else
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
data/knowledge_base/*
!data/knowledge_base/.gitkeep

# Nested data dumps (MIMIC-IV, DrugBank, DDInter, TWOSIDES, junctions)
data/raw/MIMIC*/
data/raw/mimic*/
data/raw/DrugBank/
data/raw/TwoSide/
data/raw/DDI/
data/raw/hosp/
data/raw/icu/
data/raw/hos/

# Data file formats anywhere in the repo
*.csv
*.csv.gz
*.tsv
*.tsv.gz
*.parquet
*.feather
*.arrow
*.orc
*.h5
*.hdf5
*.npy
*.npz
*.jsonl
*.jsonl.gz
*.xml
*.xml.gz
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Database files
*.duckdb
*.duckdb.wal
*.db
*.sqlite
*.sqlite3

# ==============================================================================
# Model checkpoints, weights, and serialized artifacts
# Leading slash = repo-root only, so src/models/ can be committed later
# ==============================================================================
/checkpoints/
/models/
/saved_models/
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.joblib
*.pkl
*.pickle
*.pkl.gz
*.ckpt

# ==============================================================================
# Experiments, tracking, and logs
# ==============================================================================
logs/
*.log
wandb/
/runs/
experiments/runs/*
!experiments/runs/.gitkeep
mlruns/
lightning_logs/
outputs/
artifacts/

# ==============================================================================
# Operating system & temporary files
# ==============================================================================
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
tmp/
temp/
scratch/
*.bak
*.tmp
*.orig
