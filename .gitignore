# ==============================================================================
# Datasets and large data files (PhysioNet / DrugBank / DDI / SIDER / PrimeKG)
# Keep directory layout via .gitkeep; ignore all raw & processed assets
# ==============================================================================
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
data/knowledge_base/*
!data/knowledge_base/.gitkeep
data/chroma*/
data/embeddings/

